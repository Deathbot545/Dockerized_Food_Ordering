<style>
    :root {
        --bg0: #070b14;
        --bg1: #0b1220;
        --glass: rgba(255,255,255,0.06);
        --glass2: rgba(255,255,255,0.08);
        --border: rgba(255,255,255,0.12);
        --text: rgba(255,255,255,0.92);
        --muted: rgba(255,255,255,0.70);
        --muted2: rgba(255,255,255,0.55);
        --shadow: 0 18px 60px rgba(0,0,0,0.35);
        --shadow2: 0 10px 26px rgba(0,0,0,0.24);
        --primaryA: #22c55e;
        --primaryB: #16a34a;
        --blueA: #3b82f6;
        --blueB: #2563eb;
        --danger: #ef4444;
        --dangerBg: rgba(239,68,68,0.14);
    }

    /* ===== Page background to match Discover/Menu ===== */
    body {
        font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, "Helvetica Neue", "Noto Sans", "Liberation Sans", sans-serif;
        color: var(--text);
        background: radial-gradient(900px 500px at 10% 0%, rgba(59,130,246,0.18), transparent 60%), radial-gradient(900px 500px at 95% 30%, rgba(34,197,94,0.14), transparent 55%), var(--bg1);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    /* ===== Container / spacing ===== */
    .container.my-5 {
        max-width: 1100px;
        padding: 0 14px;
    }

    /* ===== Section headings (your HTML uses plain h5/h3) ===== */
    h5 {
        margin: 0 0 12px 0;
        padding: 0;
        border: none;
        font-weight: 950;
        letter-spacing: .2px;
        color: var(--text);
    }

    h3 {
        margin: 0;
        border: none;
        padding: 0;
        color: var(--text);
        font-weight: 950;
    }

    /* ===== Cards (optional wrapper) ===== */
    .checkout-panel {
        background: var(--glass);
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: var(--shadow2);
        padding: 16px;
        backdrop-filter: blur(12px);
    }

    @@media (min-width: 992px) {
        .checkout-sticky {
            position: sticky;
            top: 86px;
        }
    }

    /* ===== Order items list ===== */
    #order-summary-section > .mb-3 {
        background: var(--glass2);
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 16px;
        padding: 12px 56px 12px 12px; /* ✅ reserve room for X on the right */
        margin-bottom: 12px !important;
        box-shadow: 0 10px 26px rgba(0,0,0,0.16);
        position: relative;
        transition: transform .12s ease, border-color .12s ease, background .12s ease;
    }

        #order-summary-section > .mb-3:hover {
            transform: translateY(-1px);
            border-color: rgba(34,197,94,0.35);
            background: rgba(255,255,255,0.09);
        }

    #order-summary-section span {
        color: var(--text);
        font-weight: 900;
    }

    /* ✅ price: keep it clean and aligned right */
    #order-summary-section .float-end {
        color: var(--text);
        font-weight: 950;
        white-space: nowrap;
        margin-right: 4px;
    }

    /* Notes pill */
    #order-summary-section .note small {
        display: inline-block;
        margin-top: 8px;
        padding: 6px 10px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(15, 23, 42, 0.55);
        color: rgba(255,255,255,0.82);
        font-weight: 850;
    }

    /* Extra items row */
    .extra-item {
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px dashed rgba(255,255,255,0.16);
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .extra-item span:first-child {
            color: rgba(255,255,255,0.78);
            font-weight: 850;
        }

        .extra-item .float-end {
            margin-left: auto;
            font-weight: 950;
            color: var(--text);
            white-space: nowrap;
        }

    /* ===== Remove buttons (perfect centering) ===== */
    .remove-item, .remove-extra-item {
        border: 1px solid rgba(239,68,68,0.22) !important;
        background: var(--dangerBg) !important;
        color: rgba(255,255,255,0.92) !important;
        width: 34px;
        height: 34px;
        border-radius: 999px !important;
        font-size: 18px;
        line-height: 1 !important; /* ✅ proper baseline */
        padding: 0 !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: transform .12s ease, background .12s ease, border-color .12s ease;
    }

    /* ✅ This is the key fix: always center relative to the row */
    .remove-item {
        position: absolute;
        top: 50%;
        right: 14px;
        transform: translateY(-50%);
    }

        .remove-item:hover, .remove-extra-item:hover {
            transform: translateY(-50%) scale(1.05); /* ✅ keep centered even on hover */
            background: rgba(239,68,68,0.20) !important;
            border-color: rgba(239,68,68,0.38) !important;
        }

    /* ===== “See all” link ===== */
    a.text-decoration-none {
        color: rgba(59,130,246,0.95);
        font-weight: 900;
        text-decoration: none !important;
    }

        a.text-decoration-none:hover {
            text-decoration: underline !important;
        }

    /* ===== Checkbox alignment ===== */
    .form-check {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-left: 12px !important;
        margin-top: 10px;
    }

    .form-check-input {
        margin: 0 !important;
        float: none !important;
        width: 18px;
        height: 18px;
        border-radius: 6px;
        accent-color: #22c55e;
    }

    .form-check-label {
        margin: 0 !important;
        line-height: 1.2;
        font-weight: 850;
        color: var(--text);
    }

    /* ===== Input group ===== */
    .input-group {
        margin-top: 12px;
        border-radius: 999px;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.06);
        box-shadow: 0 10px 26px rgba(0,0,0,0.16);
    }

        .input-group .form-control {
            border: none;
            background: transparent;
            color: var(--text);
            font-weight: 850;
            padding: 12px 14px;
        }

            .input-group .form-control::placeholder {
                color: rgba(255,255,255,0.55);
                font-weight: 750;
            }

    .btn-outline-secondary {
        border: none;
        background: rgba(59,130,246,0.16);
        color: rgba(255,255,255,0.92);
        font-weight: 950;
        padding: 10px 16px;
        transition: transform .12s ease, background .12s ease;
    }

        .btn-outline-secondary:hover {
            background: rgba(59,130,246,0.22);
            transform: translateY(-1px);
        }

    /* ===== Totals area ===== */
    .totals-line {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        color: rgba(255,255,255,0.78);
        font-weight: 850;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

        .totals-line:last-of-type {
            border-bottom: none;
        }

    .subtotal, .total {
        color: var(--text) !important;
        font-weight: 950;
        white-space: nowrap;
    }

    /* Total highlight box */
    .total-box {
        margin-top: 12px;
        border-radius: 16px;
        padding: 14px;
        border: 1px solid rgba(255,255,255,0.12);
        background: radial-gradient(800px 240px at 10% 0%, rgba(34,197,94,0.20), transparent 60%), radial-gradient(800px 240px at 95% 40%, rgba(59,130,246,0.18), transparent 55%), rgba(15,23,42,0.62);
        box-shadow: var(--shadow2);
    }

        .total-box .label {
            margin: 0;
            color: rgba(255,255,255,0.85);
            font-weight: 900;
        }

        .total-box .amount {
            margin: 6px 0 0;
            font-weight: 950;
            font-size: 1.45rem;
            color: rgba(255,255,255,0.96);
            white-space: nowrap;
        }

    /* Terms text */
    p {
        color: rgba(255,255,255,0.66);
        font-weight: 750;
        line-height: 1.55;
    }

    /* Primary CTA button */
    #order-button {
        margin-top: 14px;
        width: 100%;
        border-radius: 16px;
        padding: 12px 14px;
        font-weight: 950;
        letter-spacing: .2px;
        background: linear-gradient(90deg, var(--primaryA), var(--primaryB));
        border: none;
        color: #04130a !important;
        box-shadow: 0 14px 34px rgba(34,197,94,0.22);
        transition: transform .12s ease, box-shadow .12s ease;
    }

        #order-button:hover {
            transform: translateY(-1px);
            box-shadow: 0 18px 44px rgba(34,197,94,0.28);
        }

    @@media (max-width: 767px) {
        .container.my-5 {
            padding: 0 12px;
        }

        .checkout-panel {
            padding: 14px;
        }
    }
</style>



<div class="container my-5">
  <div class="row g-3">
    <div class="col-md-6">
      <div class="checkout-panel">
        <h5>Order summary</h5>
        <div id="order-summary-section"></div>
        <a href="#" class="text-decoration-none">See all</a>

        <h5 class="mt-4">Add Extras</h5>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="addUtensils" id="addUtensils">
          <label class="form-check-label" for="addUtensils">Add utensils</label>
        </div>

        <div class="input-group mb-3">
          <input type="text" class="form-control" placeholder="Request extra items">
          <button class="btn btn-outline-secondary" type="button" id="addExtras">Add</button>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="checkout-panel checkout-sticky">
        <h5>Order total</h5>

        <div class="totals-line">
          <span>Subtotal</span>
          <span class="float-end subtotal">LKR 0.00</span>
        </div>

        <div class="total-box">
          <p class="label">Total</p>
          <p class="amount"><span class="total">LKR 0.00</span></p>
        </div>

        <p class="mt-3">
          By proceeding to payment, you agree to our Terms of Use and acknowledge the Privacy Notice.
          You confirm you are at least 18 years of age.
        </p>

        <button class="btn btn-primary mt-3" id="order-button">Order</button>
      </div>
    </div>
  </div>
</div>


<script>
    // Declare global variables to hold tableId and outletId
    var globalTableId = '@ViewBag.TableId';
    var globalOutletId = '@ViewBag.OutletId';

    $(document).ready(function () {
        console.log("Document ready. Loading checkout page.");
        loadCheckoutPage();

        $('#order-button').click(function () {
            submitOrderForm();
        });
    });

    function loadCheckoutPage() {
        let cart = JSON.parse(localStorage.getItem('cart')) || [];
        let itemsHtml = '';
        let subTotal = 0;

        console.log("Cart loaded from localStorage:", cart);

        cart.forEach(item => {
            let itemTotal = item.qty * item.price;
            subTotal += itemTotal;

            let extraItemsHtml = '';
            if (item.extraItems && item.extraItems.length > 0) {
                item.extraItems.forEach(extraItem => {
                    extraItemsHtml += `
                            <div class="extra-item">
                                <span>${extraItem.name}</span>
                                <span class="float-end">LKR ${extraItem.price.toFixed(2)}</span>
                                <button class="btn btn-sm remove-extra-item" data-item-id="${item.id}" data-extra-item-id="${extraItem.id}">&times;</button>
                            </div>`;
                    itemTotal += extraItem.price; // Add the price of extra items to itemTotal
                });
            }

            itemsHtml += `
                    <div class="mb-3">
                        <span>${item.name} (x${item.qty})</span>
                        <span class="float-end">LKR ${itemTotal.toFixed(2)}</span>
                        <button class="btn btn-sm remove-item" data-item-id="${item.id}">&times;</button>
                        ${item.note ? `<div class="note"><small>Note: ${item.note}</small></div>` : ''}
                        ${extraItemsHtml}
                    </div>`;
        });

        $("#order-summary-section").html(itemsHtml);
        $(".subtotal").text(`LKR ${subTotal.toFixed(2)}`);
        $(".total").text(`LKR ${subTotal.toFixed(2)}`);

        $(document).on('click', '.remove-item', function () {
            const itemId = $(this).data('item-id').toString();
            console.log(`Attempting to remove item from cart: ${itemId}`);
            removeItemFromCart(itemId);
        });

        $(document).on('click', '.remove-extra-item', function () {
            const itemId = $(this).data('item-id').toString();
            const extraItemId = $(this).data('extra-item-id').toString();
            console.log(`Attempting to remove extra item from cart: ${extraItemId}`);
            removeExtraItemFromCart(itemId, extraItemId);
        });
    }

    function submitOrderForm() {
        showLoadingOverlay();

        let foodItemData = JSON.parse(localStorage.getItem('foodItemData'));
        if (!foodItemData || !foodItemData.tableId || !foodItemData.outletId) {
            console.error("TableId or outletId not found in localStorage.");
            return; // Optionally show an error message to the user
        }

        const formData = new FormData();
        formData.append('tableId', foodItemData.tableId);
        formData.append('outletId', foodItemData.outletId);
        formData.append('addUtensils', $('#addUtensils').is(':checked'));

        let cart = JSON.parse(localStorage.getItem('cart')) || [];
        cart.forEach((item, index) => {
            console.log(`Item ${index} Note:`, item.note); // Log the note
            formData.append(`items[${index}].id`, item.id);
            formData.append(`items[${index}].name`, item.name); // Make sure name is included
            formData.append(`items[${index}].qty`, item.qty);
            formData.append(`items[${index}].price`, item.price);
            formData.append(`items[${index}].note`, item.note); // Ensure note is included
            formData.append(`items[${index}].size`, item.size);
            if (item.extraItems) {
                item.extraItems.forEach((extraItem, extraIndex) => {
                    formData.append(`items[${index}].extraItems[${extraIndex}].id`, extraItem.id);
                    formData.append(`items[${index}].extraItems[${extraIndex}].name`, extraItem.name);
                    formData.append(`items[${index}].extraItems[${extraIndex}].price`, extraItem.price);
                });
            }
        });

        const orderData = {
            TableId: foodItemData.tableId,
            OutletId: foodItemData.outletId,
            MenuItems: cart.map(item => ({ ...item, name: item.name })), // Include name property for each menu item
            AddUtensils: $('#addUtensils').is(':checked'),
        };

        const jsonPayload = JSON.stringify(orderData);
        console.log(`Sending JSON payload to API: ${jsonPayload}`);

        fetch('/Order/CreateOrUpdateOrder', {
            method: 'POST',
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                if (data.orderId) {
                    localStorage.removeItem('cart');
                    localStorage.setItem('currentOrder', JSON.stringify({ orderId: data.orderId, status: 0 }));
                    setupSignalRConnection(data.orderId);
                    hideLoadingOverlay();
                    checkAndUpdateOrderStatus();
                    console.log("Order placed successfully with orderId: ", data.orderId);
                } else {
                    console.error("Order placement failed or orderId missing in response");
                }
            })
            .catch(error => {
                console.error('Error submitting order form:', error);
                hideLoadingOverlay();
            });

        return false;
    }

    function createHiddenInput(name, value) {
        let input = document.createElement('input');
        input.type = 'hidden';
        input.name = name;
        input.value = value;
        return input;
    }

    function removeItemFromCart(itemId) {
        let cart = JSON.parse(localStorage.getItem('cart')) || [];
        cart = cart.filter(item => item.id.toString() !== itemId);
        localStorage.setItem('cart', JSON.stringify(cart));
        loadCheckoutPage(); // Update the UI after removing the item
        updateCartButton();
    }

    function removeExtraItemFromCart(itemId, extraItemId) {
        let cart = JSON.parse(localStorage.getItem('cart')) || [];
        cart.forEach(item => {
            if (item.id.toString() === itemId && item.extraItems) {
                item.extraItems = item.extraItems.filter(extraItem => extraItem.id.toString() !== extraItemId);
            }
        });
        localStorage.setItem('cart', JSON.stringify(cart));
        loadCheckoutPage(); // Update the UI after removing the extra item
        updateCartButton();
    }

    function updateCartButton() {
        let cart = JSON.parse(localStorage.getItem('cart')) || [];
        let currentTime = new Date().getTime();
        let durationLimit = 24 * 60 * 60 * 1000;

        cart = cart.filter(item => currentTime - item.timestamp < durationLimit);
        localStorage.setItem('cart', JSON.stringify(cart));

        let itemCount = cart.reduce((count, item) => count + item.qty, 0);
        let total = cart.reduce((total, item) =>
            total + item.qty * item.price + (item.extraItems ? item.extraItems.reduce((extraTotal, extraItem) => extraTotal + extraItem.price, 0) : 0), 0);
        $(".cart-items-count").text(itemCount);
        $(".cart-total").text(`LKR ${total.toFixed(2)}`);
    }

    function showLoadingOverlay() {
        $("#loading-overlay").show();
    }

    function hideLoadingOverlay() {
        $("#loading-overlay").hide();
    }
</script>


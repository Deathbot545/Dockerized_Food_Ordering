@{
    ViewData["Title"] = "Guest Menu";
    var outletId = (ViewBag.OutletId ?? "").ToString();
    var tableId = (ViewBag.TableId ?? "").ToString();
    var demoEnabledRaw = (ViewBag.DemoEnabled ?? false).ToString().ToLower();
}
<style>
    /* ---------- Page shell ---------- */
    .menu-wrap {
        padding: 14px 14px 90px;
        max-width: 1180px;
        margin: 0 auto;
    }

    /* ---------- Global readability defaults ---------- */
    body {
        color: #0b1220;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
    }

    h1, h2, h3, h4, h5 {
        color: #07101f;
    }

    /* ---------- Hero header ---------- */
    .hero {
        border-radius: 18px;
        overflow: hidden;
        position: relative;
        /* more contrast so text always pops */
        background: linear-gradient(135deg, rgba(2,6,23,0.90), rgba(2,6,23,0.78)), radial-gradient(1000px 500px at 15% 0%, rgba(59,130,246,0.28), transparent 60%), radial-gradient(900px 500px at 95% 35%, rgba(34,197,94,0.22), transparent 55%);
        box-shadow: 0 18px 60px rgba(0,0,0,0.28);
        border: 1px solid rgba(255,255,255,0.14);
        padding: 18px;
        color: #fff;
        margin-top: 12px;
    }

    .hero-row {
        display: flex;
        gap: 14px;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
    }

    .hero-left {
        display: flex;
        gap: 14px;
        align-items: center;
    }

    #outlet-logo {
        width: 56px;
        height: 56px;
        border-radius: 999px;
        object-fit: cover;
        border: 1px solid rgba(255,255,255,0.22);
        box-shadow: 0 10px 28px rgba(0,0,0,0.30);
        background: rgba(255,255,255,0.10);
    }

    #outlet-name {
        margin: 0;
        font-weight: 950;
        letter-spacing: .2px;
        font-size: clamp(1.2rem, 2.4vw, 1.85rem);
        color: rgba(255,255,255,0.98);
        text-shadow: 0 2px 14px rgba(0,0,0,0.55);
    }

    .hero-sub {
        margin: 4px 0 0;
        color: rgba(255,255,255,0.88); /* stronger than before */
        font-weight: 800;
        font-size: .95rem;
        text-shadow: 0 2px 12px rgba(0,0,0,0.45);
    }

    .hero-right {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    /* ---------- Search pill ---------- */
    .pill {
        border-radius: 999px;
        padding: 9px 12px;
        border: 1px solid rgba(255,255,255,0.20);
        background: rgba(255,255,255,0.12);
        color: rgba(255,255,255,0.98);
        font-weight: 900;
        display: inline-flex;
        gap: 10px;
        align-items: center;
        backdrop-filter: blur(10px);
        white-space: nowrap;
        box-shadow: 0 10px 24px rgba(0,0,0,0.18);
    }

        .pill i {
            color: rgba(255,255,255,0.95);
        }

        .pill input {
            border: none;
            outline: none;
            background: transparent;
            color: rgba(255,255,255,0.98);
            font-weight: 850;
            min-width: 220px;
        }

            .pill input::placeholder {
                color: rgba(255,255,255,0.78);
                font-weight: 800;
            }

    /* ---------- Buttons ---------- */
    .btn-pill {
        border-radius: 999px !important;
        font-weight: 900 !important;
        padding: 10px 14px !important;
    }

    .btn-primary-glow {
        background: linear-gradient(90deg, #22c55e, #16a34a);
        border: none;
        color: #04130a !important;
        box-shadow: 0 14px 34px rgba(34,197,94,0.25);
    }

    .btn-ghost {
        background: rgba(255,255,255,0.10);
        border: 1px solid rgba(255,255,255,0.18);
        color: rgba(255,255,255,0.95) !important;
    }

        .btn-ghost:hover {
            background: rgba(255,255,255,0.14);
        }

    /* ---------- Sticky category navbar ---------- */
    .custom-navbar {
        margin-top: 14px;
        position: sticky;
        top: 70px;
        z-index: 1000;
        border-radius: 14px;
        border: 1px solid rgba(0,0,0,0.10);
        background: rgba(255,255,255,0.96);
        box-shadow: 0 10px 28px rgba(0,0,0,0.12);
        padding: 10px 12px;
        backdrop-filter: blur(10px);
    }

        .custom-navbar .nav-link {
            font-weight: 950;
            color: #0b1220; /* darker */
            padding: 8px 12px;
            border-radius: 999px;
            margin: 4px 6px;
            transition: background .12s ease, color .12s ease, transform .12s ease;
            white-space: nowrap;
        }

            .custom-navbar .nav-link:hover {
                background: rgba(34,197,94,0.18);
                color: #064e3b;
                transform: translateY(-1px);
            }

            .custom-navbar .nav-link.active {
                background: rgba(59,130,246,0.18);
                color: #1e40af;
            }

    /* ---------- Section header ---------- */
    .section-head {
        margin-top: 16px;
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 10px;
        flex-wrap: wrap;
    }

        .section-head h2 {
            margin: 0;
            font-weight: 950;
            color: #07101f;
            font-size: 1.2rem;
        }

        .section-head small {
            color: #334155; /* darker than before */
            font-weight: 900;
        }

    /* ---------- Cards ---------- */
    .menu-grid {
        margin-top: 12px;
    }

    .menu-card {
        border: 1px solid rgba(0,0,0,0.06);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 12px 36px rgba(0,0,0,0.10);
        transition: transform .14s ease, box-shadow .14s ease;
        height: 100%;
        cursor: pointer;
        background: #fff;
    }

        .menu-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 46px rgba(0,0,0,0.16);
        }

    .menu-cover {
        width: 100%;
        height: 190px;
        object-fit: cover;
        display: block;
        background: #e5e7eb;
    }

    .menu-body {
        padding: 12px 12px 14px;
    }

    .menu-title {
        margin: 0;
        font-weight: 950;
        color: #07101f;
        font-size: 1.04rem;
        line-height: 1.2;
    }

    .menu-desc {
        margin: 8px 0 0;
        color: #334155; /* stronger contrast */
        font-weight: 800;
        font-size: .94rem;
        min-height: 36px;
    }

    .menu-foot {
        margin-top: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    .price {
        font-weight: 950;
        color: #0b1220;
        font-size: 1.04rem;
        white-space: nowrap;
    }

    .mini-chip {
        border-radius: 999px;
        padding: 6px 10px;
        font-weight: 950;
        font-size: .78rem;
        background: rgba(59,130,246,0.16);
        color: #1e40af;
        border: 1px solid rgba(59,130,246,0.28);
        white-space: nowrap;
    }

    /* ---------- Loading + empty ---------- */
    .loading {
        border-radius: 16px;
        padding: 14px;
        background: #fff;
        border: 1px solid rgba(0,0,0,0.10);
        box-shadow: 0 10px 28px rgba(0,0,0,0.10);
        color: #0b1220;
        font-weight: 900;
    }

    .empty-state {
        margin-top: 12px;
        border-radius: 16px;
        padding: 16px;
        background: #fff;
        border: 1px dashed rgba(0,0,0,0.22);
        color: #0b1220;
        font-weight: 900;
    }

    /* ---------- Cart bar ---------- */
    .cart-fixed-bottom {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background: rgba(2,6,23,0.96); /* darker */
        color: rgba(255,255,255,0.98);
        padding: 12px 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        box-shadow: 0 -12px 30px rgba(0,0,0,0.28);
        z-index: 1100;
        backdrop-filter: blur(10px);
    }

        .cart-fixed-bottom .cart-left {
            font-weight: 950;
            letter-spacing: .2px;
            color: rgba(255,255,255,0.98);
        }

            .cart-fixed-bottom .cart-left small {
                display: block;
                font-weight: 850;
                opacity: 0.88; /* brighter */
                color: rgba(255,255,255,0.86);
            }

    /* make call-waiter button consistent */
    .call-waiter-button, .call-waiter-nav-button {
        border-radius: 999px !important;
        font-weight: 950 !important;
    }

    @@media (max-width: 768px) {
        .custom-navbar {
            top: 64px;
        }

        .pill input {
            min-width: 160px;
        }
    }
</style>


<div class="menu-wrap">

    <!-- HERO -->
    <section class="hero">
        <div class="hero-row">
            <div class="hero-left">
                <img id="outlet-logo" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+XvJwAAAAASUVORK5CYII=" alt="Outlet Logo" />
                <div>
                    <h1 id="outlet-name">Loading outlet...</h1>
                    <div class="hero-sub">Table #<span id="table-id-text">@tableId</span> · Tap an item to view details</div>
                </div>
            </div>

            <div class="hero-right">
                <div class="pill">
                    <i class="fas fa-search"></i>
                    <input id="menuSearch" type="text" placeholder="Search menu items..." />
                </div>

                <button type="button" class="btn btn-ghost btn-pill call-waiter-nav-button">
                    <i class="fas fa-concierge-bell"></i> Call Waiter
                </button>
            </div>
        </div>
    </section>

    <!-- Category navbar -->
    <nav class="navbar navbar-expand-lg custom-navbar">
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse d-flex justify-content-between align-items-center" id="navbarNav">
            <ul class="navbar-nav" id="category-navbar"></ul>
        </div>
    </nav>

    <div class="section-head">
        <h2>Menu</h2>
        <small id="menuCountText">0 items</small>
    </div>

    <!-- Container for menu items -->
    <div id="menu-container" class="mt-2">
        <div class="loading">Loading menu…</div>
    </div>
</div>

<!-- Cart -->
<div id="cart-button" class="cart-fixed-bottom" style="display:none;">
    <div class="cart-left">
        <span><span id="cart-items-count">0</span> Items · LKR <span id="cart-total">0.00</span></span>
        <small>Tap to checkout</small>
    </div>
    <button class="btn btn-primary-glow btn-pill call-waiter-button" type="button">
        <i class="fas fa-concierge-bell"></i> Call Waiter
    </button>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.7/signalr.min.js"></script>
<script>
    $(document).ready(function () {

        const outletId = '@outletId';
        const tableId = '@tableId';
        const demoEnabled = '@demoEnabledRaw' === 'true';

        // Build endpoints based on demo mode
        const menuEndpoint = demoEnabled
            ? `/Order/DemoMenuItems?outletId=${encodeURIComponent(outletId)}`
            : `https://restosolutionssaas.com/api/MenuApi/GetMenuItems/${encodeURIComponent(outletId)}`;

        const outletInfoEndpoint = demoEnabled
            ? `/Order/DemoOutletInfo?outletId=${encodeURIComponent(outletId)}`
            : `https://restosolutionssaas.com/api/OutletApi/outletInfo/${encodeURIComponent(outletId)}`;

        const callWaiterEndpoint = demoEnabled
            ? `/Order/DemoCallWaiter`
            : `https://restosolutionssaas.com/api/OrderApi/CallWaiter`;

        // SignalR only when NOT demo (avoid noisy errors in demo)
        if (!demoEnabled) {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("https://restosolutionssaas.com/api/OrderApi/orderStatusHub")
                .build();

            connection.start()
                .then(() => console.log("SignalR connected"))
                .catch(err => console.warn("SignalR connection error:", err));
        }

        function escapeHtml(text) {
            return (text ?? '').toString()
                .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;").replace(/'/g, "&#039;");
        }

        function updateCartButton() {
            let cart = JSON.parse(localStorage.getItem('cart')) || [];
            const currentTime = new Date().getTime();
            const durationLimit = 24 * 60 * 60 * 1000;

            cart = cart.filter(item => currentTime - (item.timestamp || currentTime) < durationLimit);
            localStorage.setItem('cart', JSON.stringify(cart));

            const itemCount = cart.reduce((count, item) => count + (item.qty || 0), 0);
            const total = cart.reduce((sum, item) => sum + ((item.price || 0) * (item.qty || 0)), 0);

            $("#cart-items-count").text(itemCount);
            $("#cart-total").text(total.toFixed(2));

            if (itemCount > 0) $("#cart-button").show();
            else $("#cart-button").hide();
        }

        function buildCategoryMap(menuItems) {
            const categoryMap = {};
            menuItems.forEach(mi => {
                if (!categoryMap[mi.menuCategoryId]) {
                    categoryMap[mi.menuCategoryId] = { name: mi.categoryName, items: [] };
                }
                categoryMap[mi.menuCategoryId].items.push(mi);
            });
            return categoryMap;
        }

        function renderMenu(menuItems) {
            const categoryMap = buildCategoryMap(menuItems);

            let navbarItems = '';
            let menuHtml = '';
            let totalItems = 0;

            Object.keys(categoryMap).forEach(categoryId => {
                const category = categoryMap[categoryId];
                navbarItems += `<li class="nav-item"><a class="nav-link" href="#cat-${categoryId}">${escapeHtml(category.name)}</a></li>`;

                menuHtml += `
                        <section id="cat-${categoryId}" class="menu-grid mt-3" data-category="${escapeHtml(category.name)}">
                            <div class="section-head">
                                <h2>${escapeHtml(category.name)}</h2>
                                <small>${category.items.length} items</small>
                            </div>
                            <div class="row mt-2">`;

                category.items.forEach(mi => {
                    totalItems++;

                    // Your API/dummy returns base64 in "image"
                    const imageBase64 = mi.image || "";
                    const imgSrc = imageBase64
                        ? `data:image/png;base64,${imageBase64}`
                        : `https://images.unsplash.com/photo-1540189549336-e6e99c3679fe?auto=format&fit=crop&w=1200&q=80`; // fallback

                    const price = (mi.price ?? 0);
                    const desc = mi.description ?? "";

                    menuHtml += `
                            <div class="col-12 col-md-6 col-lg-4 mb-3 menu-item-card"
                                 data-name="${escapeHtml(mi.name)}"
                                 data-desc="${escapeHtml(desc)}"
                                 data-category="${escapeHtml(category.name)}">
                                <div class="card menu-card"
                                     data-item-id="${mi.id}"
                                     data-category-id="${mi.menuCategoryId}"
                                     data-outlet-id="${outletId}"
                                     data-table-id="${tableId}">
                                    <img class="menu-cover" src="${imgSrc}" alt="${escapeHtml(mi.name)}" loading="lazy" />
                                    <div class="menu-body">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <h5 class="menu-title">${escapeHtml(mi.name)}</h5>
                                            <span class="mini-chip">${escapeHtml(category.name)}</span>
                                        </div>
                                        <p class="menu-desc">${escapeHtml(desc)}</p>
                                        <div class="menu-foot">
                                            <div class="price">LKR ${Number(price).toFixed(2)}</div>
                                            <button type="button" class="btn btn-primary-glow btn-pill btn-sm js-add"
                                                    data-item-id="${mi.id}"
                                                    data-name="${escapeHtml(mi.name)}"
                                                    data-price="${price}">
                                                <i class="fas fa-plus"></i> Add
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>`;
                });

                menuHtml += `
                            </div>
                        </section>`;
            });

            $('#category-navbar').html(navbarItems);
            $('#menu-container').html(menuHtml);
            $('#menuCountText').text(`${totalItems} items`);

            // Smooth scroll for category links
            $('#category-navbar a').on('click', function (e) {
                e.preventDefault();
                const target = $(this).attr('href');
                const offset = $(target).offset()?.top ?? 0;
                window.scrollTo({ top: offset - 110, behavior: 'smooth' });

                $('#category-navbar a').removeClass('active');
                $(this).addClass('active');
            });
        }

        function fetchAndDisplayMenuItems() {
            $('#menu-container').html(`<div class="loading">Loading menu…</div>`);

            $.get(menuEndpoint, function (menuItems) {
                if (!menuItems || menuItems.length === 0) {
                    $('#menu-container').html(`
                            <div class="empty-state">
                                <strong>No menu items found.</strong>
                                <div class="mt-1">Try again later or select a different outlet.</div>
                            </div>`);
                    $('#menuCountText').text('0 items');
                    return;
                }

                renderMenu(menuItems);
                updateCartButton();
            })
                .fail(function (jqXHR, textStatus, errorThrown) {
                    console.warn("Menu request failed:", textStatus, errorThrown);
                    $('#menu-container').html(`
                        <div class="empty-state">
                            <strong>Couldn’t load the menu.</strong>
                            <div class="mt-1">If you’re in demo mode, ensure Demo endpoints exist in OrderController.</div>
                        </div>`);
                });
        }

        function fetchAndDisplayOutletInfo() {
            $.get(outletInfoEndpoint, function (outletInfo) {
                if (outletInfo?.customerFacingName) {
                    $("#outlet-name").text(outletInfo.customerFacingName);
                } else {
                    $("#outlet-name").text("Outlet");
                }

                if (outletInfo?.logo) {
                    $("#outlet-logo").attr('src', `data:image/png;base64,${outletInfo.logo}`).show();
                }
            })
                .fail(function () {
                    $("#outlet-name").text("Outlet");
                });
        }

        // Search filter (name + desc + category)
        $('#menuSearch').on('input', function () {
            const q = ($(this).val() || "").toString().toLowerCase().trim();
            let visible = 0;

            $('.menu-item-card').each(function () {
                const name = ($(this).data('name') || '').toString().toLowerCase();
                const desc = ($(this).data('desc') || '').toString().toLowerCase();
                const cat = ($(this).data('category') || '').toString().toLowerCase();

                const show = !q || name.includes(q) || desc.includes(q) || cat.includes(q);
                $(this).toggle(show);
                if (show) visible++;
            });

            $('#menuCountText').text(`${visible} items`);
        });

        // Add to cart (simple demo behavior)
        $('#menu-container').on('click', '.js-add', function (e) {
            e.stopPropagation();

            const id = parseInt($(this).data('item-id'), 10);
            const name = ($(this).data('name') || '').toString();
            const price = parseFloat($(this).data('price'));

            let cart = JSON.parse(localStorage.getItem('cart')) || [];
            const existing = cart.find(x => x.id === id);

            if (existing) {
                existing.qty = (existing.qty || 1) + 1;
                existing.timestamp = new Date().getTime();
            } else {
                cart.push({
                    id,
                    name,
                    price,
                    qty: 1,
                    note: "",
                    size: "regular",
                    extraItems: [],
                    timestamp: new Date().getTime()
                });
            }

            localStorage.setItem('cart', JSON.stringify(cart));
            updateCartButton();
        });

        // Card click -> your existing flow to FoodDetail
        $('#menu-container').on('click', '.menu-card', function () {
            const itemId = $(this).data('item-id');
            const categoryId = $(this).data('category-id');
            const outletId = $(this).data('outlet-id');
            const tableId = $(this).data('table-id');
            const customerFacingName = $("#outlet-name").text();

            $.post('/Order/RedirectToDetail', {
                itemId: itemId,
                categoryId: categoryId,
                outletId: outletId,
                tableId: tableId,
                customerFacingName: customerFacingName
            }).done(function (response) {
                if (response.success) {
                    localStorage.setItem('foodItemData', JSON.stringify({
                        itemId: response.itemId,
                        categoryId: response.categoryId,
                        outletId: response.outletId,
                        tableId: response.tableId,
                        customerFacingName: response.customerFacingName
                    }));

                    window.location.href = response.redirectUrl;
                } else {
                    console.error("Failed to redirect");
                }
            });
        });

        // Call Waiter (demo-safe)
        $('.call-waiter-button, .call-waiter-nav-button').on('click', function (e) {
            e.stopPropagation();

            $.ajax({
                url: callWaiterEndpoint,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ tableId: tableId }),
                success: function () {
                    alert("Waiter has been called!");
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    console.error("Error calling waiter:", textStatus, errorThrown);
                    alert("Could not call waiter (demo/API).");
                }
            });
        });

        // Cart click -> Checkout
        $('#cart-button').on('click', function () {
            window.location.href = '/Order/Checkout';
        });

        // Init
        fetchAndDisplayMenuItems();
        fetchAndDisplayOutletInfo();
        updateCartButton();
    });
</script>
